APP_NAME=Document Validator Backend
API_PREFIX=/api

# MariaDB connection settings used by the backend.
# DATABASE_URL can override these fields if you want to provide a full DSN.
DATABASE_URL=
DB_USERNAME=root
DB_PASSWORD=131104
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doc_validator
DB_CHARSET=utf8mb4

# Optional. Without a key, the backend uses deterministic local fallback output.
# OpenAI-compatible providers are supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Models support.
GITHUB_ENDPOINT=https://models.github.ai/inference
GITHUB_COMPLETION_API_KEY=
GENERATIVE_MODEL_NAME=openai/gpt-4o-mini

LLM_TEMPERATURE=0.2

MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
