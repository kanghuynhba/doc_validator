APP_NAME=Document Validator Backend
API_PREFIX=/api

# Development default uses local SQLite. For MariaDB use:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/doc_validator
DATABASE_URL=sqlite:///./doc_validator.db

# Optional. Without a key, the backend uses deterministic local fallback output.
# OpenAI-compatible providers are supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Models support.
GITHUB_ENDPOINT=https://models.github.ai/inference
GITHUB_COMPLETION_API_KEY=
GENERATIVE_MODEL_NAME=openai/gpt-4o-mini

LLM_TEMPERATURE=0.2

MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
