APP_NAME=Document Validator Backend
API_PREFIX=/api

# SQLite database used by the backend.
# Override with another SQLAlchemy DSN if needed.
DATABASE_URL=sqlite:///./doc_validator.db

# Optional. Without a key, the backend can call a local OpenAI-compatible LLM server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible LLM endpoint. Defaults to local Qwen on port 8081.
GITHUB_ENDPOINT=http://127.0.0.1:8081/v1
GITHUB_COMPLETION_API_KEY=
GENERATIVE_MODEL_NAME=qwen2.5-3b-instruct

LLM_TEMPERATURE=0.2

MAX_UPLOAD_MB=20
CHUNK_SIZE=10000
CHUNK_OVERLAP=500
DIRECT_SUMMARY_CHAR_LIMIT=30000
MAX_LLM_CONCURRENCY=1
SUMMARY_MAX_TOKENS=900
REDUCE_MAX_TOKENS=1000
QUIZ_MAX_TOKENS=1600
